# Copia este archivo como .env y llena los valores.
# El .env nunca se sube a git: las mismas variables se cargan en
# Vercel > Settings > Environment Variables.

# --- Cerebro del chat (obligatorio) ---
# Se saca en https://platform.deepseek.com > API keys
DEEPSEEK_API_KEY=

# Opcionales. Están acá para poder cambiar de proveedor sin tocar código:
# cualquier API compatible con OpenAI funciona cambiando estas dos líneas.
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-chat

# --- Aviso de nuevos contactos por correo (opcional) ---
# Se saca en https://resend.com. Sin esto el chat funciona, pero el botón
# "Dejar mis datos" no puede enviar nada.
RESEND_API_KEY=
LEAD_DESTINO=contacto@desquiciado-sas.com
# El remitente debe ser un dominio verificado en Resend.
# Para probar sirve: Chat Desquiciado <onboarding@resend.dev>
LEAD_REMITENTE=Chat Desquiciado <onboarding@resend.dev>

# --- Dominios que pueden llamar al chat (opcional) ---
# El propio dominio desde el que se abre el sitio siempre vale (también en local
# y en la vista previa de Vercel). Si no se define, se suman desquiciado-sas.com
# y www.
# ORIGENES_PERMITIDOS=https://desquiciado-sas.com,https://www.desquiciado-sas.com

# --- Límite de peticiones compartido (recomendado en producción) ---
# Se llenan solos al conectar Upstash Redis en Vercel > Storage. Sin ellos, el
# límite cuenta en memoria de cada copia de la función y no hay topes diarios.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# Topes diarios para todo el sitio (solo funcionan con Redis).
# CHAT_TOPE_DIARIO=1500
# LEAD_TOPE_DIARIO=50

# Sal para la huella de las IP en los registros. Cualquier texto largo y al azar.
# SAL_REGISTROS=
